{
  "name": "desktop-recorder",
  "version": "1.1.2",
  "private": true,
  "description": "Records your screen or a window with a camera bubble and saves an MP4.",
  "author": "eliezerord",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron build/make-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "ffmpeg-static": "5.3.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.eliezerord.desktoprecorder",
    "productName": "Desktop Recorder",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/uiohook-napi/**"
    ],
    "extraResources": [
      {
        "from": "cli",
        "to": "cli",
        "filter": [
          "drec.js",
          "drec.cmd"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Desktop Recorder",
      "include": "build/installer.nsh",
      "artifactName": "Desktop-Recorder-Setup-${version}.${ext}"
    }
  }
}
